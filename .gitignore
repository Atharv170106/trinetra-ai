# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Node ---
node_modules/
dist/
.vite/

# --- Large binary assets (must be provisioned manually, never committed) ---
backend/model_weights/*
!backend/model_weights/.gitkeep
backend/sample_data/*
!backend/sample_data/.gitkeep
backend/tiles_cache/*
!backend/tiles_cache/.gitkeep

# --- Qdrant persistent volume ---
qdrant_storage/*
!qdrant_storage/.gitkeep

# --- Runtime audit + tile data (Phase 6 bind mounts) ---
# Analyst verdicts are operational records, not source. They belong to a
# deployment, not the repo - and on a real system they are evidence.
backend/audit/
backend/audit_log.jsonl
backend/tiles_cache/*
!backend/tiles_cache/.gitkeep

# --- Env / editor ---
.env
.idea/
.vscode/

# --- Secure drop zone (Step 1: staged imagery awaiting watchdog pickup) ---
# Real Sentinel-2 crops, hundreds of MB per scene, and on a live system this is
# operational imagery. Ships with the deployment, never with the source.
backend/secure_drop_zone/*
!backend/secure_drop_zone/.gitkeep
